{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "npx --yes pnpm --filter @workspace/roma-store run build && node ./scripts/copy-dist.mjs",
    "build:all": "npx --yes pnpm -r --if-present run build && node ./scripts/copy-dist.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "bot": "node bot.js"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "@supabase/supabase-js": "^2.117.1",
    "dotenv": "^18.0.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
